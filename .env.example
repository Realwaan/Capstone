# GitHub OAuth Credentials (Optional)
VITE_GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Personal Access Token for Private Repos (Generate free at https://github.com/settings/tokens):
VITE_GITHUB_TOKEN=your-github-personal-access-token
VITE_GITHUB_DEFAULT_REPO=

# Supabase PostgreSQL Database & Real-Time Sync
# Create a free project at https://supabase.com
# Find these in Project Settings -> API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini Free AI Assistant (100% Free at https://aistudio.google.com)
VITE_GEMINI_API_KEY=your-gemini-api-key

# In development only, notifications can use VITE_DISCORD_WEBHOOK_URL locally.
# Production uses the server-only DISCORD_WEBHOOK_URL below.

# Discord ticket sync through the existing CapStoneFlow bot.
# VITE_DISCORD_TICKET_SYNC is public; the remaining variables are server-only.
VITE_DISCORD_TICKET_SYNC=false
CAPSTONE_BOT_URL=https://website-associate-bot.onrender.com
CAPSTONE_API_SECRET=generate-a-long-random-secret
# HMAC secret used to issue the HttpOnly website session after GitHub OAuth.
# Generate at least 32 random characters and set it in Vercel only.
CAPSTONE_SESSION_SECRET=generate-another-long-random-secret
# Server-only Discord webhook used for non-ticket workspace notifications.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
