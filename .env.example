# ==============================================================================
# CapStoneFlow - Environment Configuration Template
# Copy this file to `.env` and fill in your GitHub OAuth App credentials.
# ==============================================================================

# 1. Public Client ID (Safe in frontend, used for redirect)
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# 2. Server/Backend Client Secret (CRITICAL: Used by local Vite proxy / backend only)
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# 3. Authorization Callback URL (Matches your registered GitHub OAuth App setting)
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# 4. Optional: Default GitHub Organization or Repo
VITE_GITHUB_DEFAULT_REPO=https://github.com/your-username/capstone
