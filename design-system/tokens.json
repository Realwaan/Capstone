{
  "name": "Linear + Raycast Unified Design Tokens",
  "version": "1.0.0",
  "sources": [
    "https://linear.app",
    "https://www.raycast.com"
  ],
  "theme": {
    "dark": {
      "colors": {
        "background": {
          "app": "#08090c",
          "sidebar": "rgba(13, 15, 22, 0.82)",
          "card": "rgba(18, 21, 30, 0.68)",
          "cardHover": "rgba(26, 31, 44, 0.85)",
          "elevated": "rgba(22, 26, 38, 0.78)",
          "input": "rgba(11, 13, 19, 0.9)",
          "glass": "rgba(14, 16, 24, 0.8)"
        },
        "border": {
          "subtle": "rgba(255, 255, 255, 0.07)",
          "card": "rgba(255, 255, 255, 0.11)",
          "highlight": "rgba(255, 255, 255, 0.18)",
          "focus": "#5e6ad2"
        },
        "text": {
          "primary": "#f7f8f8",
          "secondary": "#8a8f98",
          "muted": "#575b63",
          "accent": "#5e6ad2"
        },
        "accents": {
          "primary": "#5e6ad2",
          "primaryHover": "#4f5bc0",
          "primaryLight": "rgba(94, 106, 210, 0.15)",
          "primaryGlow": "rgba(94, 106, 210, 0.3)",
          "raycastRed": "#ff6363",
          "raycastOrange": "#f2994a",
          "raycastGreen": "#30d158",
          "raycastCyan": "#64d2ff",
          "raycastPurple": "#9d5bd2",
          "status": {
            "backlog": "#8a8f98",
            "todo": "#5e6ad2",
            "inProgress": "#f2994a",
            "peerReview": "#9d5bd2",
            "adviserReview": "#ff6363",
            "done": "#30d158"
          }
        },
        "shadows": {
          "sm": "0 1px 2px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08)",
          "md": "0 4px 16px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1)",
          "lg": "0 20px 48px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.14)"
        }
      }
    },
    "light": {
      "colors": {
        "background": {
          "app": "#f7f8f9",
          "sidebar": "rgba(255, 255, 255, 0.85)",
          "card": "rgba(255, 255, 255, 0.88)",
          "cardHover": "#ffffff",
          "elevated": "#ffffff",
          "input": "#ffffff",
          "glass": "rgba(255, 255, 255, 0.9)"
        },
        "border": {
          "subtle": "rgba(0, 0, 0, 0.06)",
          "card": "rgba(0, 0, 0, 0.09)",
          "highlight": "rgba(0, 0, 0, 0.14)",
          "focus": "#5e6ad2"
        },
        "text": {
          "primary": "#0e1017",
          "secondary": "#575b63",
          "muted": "#8a8f98",
          "accent": "#5e6ad2"
        },
        "accents": {
          "primary": "#5e6ad2",
          "primaryHover": "#4f5bc0",
          "primaryLight": "rgba(94, 106, 210, 0.1)",
          "primaryGlow": "rgba(94, 106, 210, 0.2)",
          "raycastRed": "#e5484d",
          "raycastOrange": "#e58530",
          "raycastGreen": "#30a46c",
          "raycastCyan": "#0090ff",
          "raycastPurple": "#8e4ec6"
        },
        "shadows": {
          "sm": "0 1px 2px rgba(0, 0, 0, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9)",
          "md": "0 4px 16px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 1)",
          "lg": "0 20px 48px rgba(0, 0, 0, 0.09), inset 0 1px 0 rgba(255, 255, 255, 1)"
        }
      }
    }
  },
  "typography": {
    "fontFamilies": {
      "display": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', system-ui, sans-serif",
      "sans": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui, sans-serif",
      "mono": "'SF Mono', 'JetBrains Mono', Menlo, monospace"
    },
    "typeScale": {
      "xs": "0.68rem",
      "sm": "0.78rem",
      "base": "0.85rem",
      "md": "0.98rem",
      "lg": "1.15rem",
      "xl": "1.45rem",
      "2xl": "1.85rem"
    },
    "letterSpacing": {
      "tighter": "-0.035em",
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.04em"
    }
  },
  "radii": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "full": "9999px"
  },
  "motion": {
    "easeOut": "cubic-bezier(0.23, 1, 0.32, 1)",
    "easeInOut": "cubic-bezier(0.77, 0, 0.175, 1)",
    "easeSpring": "cubic-bezier(0.32, 0.72, 0, 1)",
    "durationFast": "140ms",
    "durationNormal": "200ms",
    "scaleActive": "0.97"
  }
}
