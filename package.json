{
  "name": "capstone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win --x64",
    "exe:build": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "driver.js": "^1.8.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.capstone.luau-workspace",
    "productName": "Luau Workspace",
    "files": ["dist/**/*", "electron/**/*", "src-tauri/bin/luau-lsp.exe"],
    "asarUnpack": ["src-tauri/bin/luau-lsp.exe", "electron/bin/**/*"],
    "extraResources": [{ "from": "src-tauri/bin/luau-lsp.exe", "to": "bin/luau-lsp.exe" }],
    "directories": { "buildResources": "public", "output": "release" },
    "win": { "target": "nsis", "icon": "public/vite.svg" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
